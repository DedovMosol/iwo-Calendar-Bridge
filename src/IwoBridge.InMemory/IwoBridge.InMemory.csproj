<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ин-мемори адаптер портов приёмника: для прогонов и тестов без сервера. Зависит только от Core. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>IwoBridge.InMemory</AssemblyName>
    <RootNamespace>IwoBridge.InMemory</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IwoBridge.Core\IwoBridge.Core.csproj" />
  </ItemGroup>

</Project>
