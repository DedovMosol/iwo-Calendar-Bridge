<Window x:Class="IwoBridge.Wpf.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История операций — iwo Calendar Bridge"
        Style="{StaticResource AppWindow}"
        Width="1120" Height="640" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True">
    <!-- Журнал операций: каждое копирование (вручную и по расписанию) и каждая очистка — когда, откуда и куда, период,
         сколько создано, перезаписано, удалено и не удалось, итог и длительность. Подробности выбранной строки — внизу,
         их можно выделить и скопировать. Немодальное окно: открыто рядом с программой, новые операции появляются сверху.
         Esc закрывает окно. -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="ApplicationCommands.Close" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close" Executed="OnClose" />
    </Window.CommandBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="90" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8" Text="{Binding Summary}" TextWrapping="Wrap"
                   AutomationProperties.Name="Итог за 7 дней" AutomationProperties.AutomationId="HistorySummary" />

        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsReadOnly="True"
                  SelectionMode="Single" AutomationProperties.Name="Операции" AutomationProperties.AutomationId="HistoryRows">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Когда" Binding="{Binding When}" Width="125" MinWidth="100" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Операция" Binding="{Binding Operation}" Width="122" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Откуда → куда" Binding="{Binding Route}" Width="*" MinWidth="140" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Период" Binding="{Binding Period}" Width="182" MinWidth="80" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Создано" Binding="{Binding Created, StringFormat={}{0:N0}}" Width="66" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Перезап." Binding="{Binding Updated, StringFormat={}{0:N0}}" Width="70" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Удалено" Binding="{Binding Deleted, StringFormat={}{0:N0}}" Width="68" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Ошибок" Binding="{Binding Failed, StringFormat={}{0:N0}}" Width="62" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Итог" Binding="{Binding Outcome}" Width="104" MinWidth="70" ElementStyle="{StaticResource TrimmedCell}" />
                <DataGridTextColumn Header="Длилось" Binding="{Binding Duration}" Width="70" MinWidth="56" ElementStyle="{StaticResource TrimmedCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}"
                   Text="Операций пока не было. Здесь появится каждое копирование и каждая очистка — с числами и итогом." />

        <TextBlock Grid.Row="2" Style="{StaticResource SectionText}" Margin="0,12,0,6" Text="Подробности" />
        <TextBox Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 Text="{Binding Selected.Details, Mode=OneWay}" AutomationProperties.Name="Подробности выбранной операции"
                 AutomationProperties.AutomationId="HistoryDetails" />

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource HintText}" Margin="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{Binding LocationText}" ToolTip="{Binding LocationText}" />
            <Button Grid.Column="1" Margin="12,0,0,0" Content="_Обновить" Command="{Binding RefreshCommand}"
                    ToolTip="Перечитать журнал (F5)" />
            <Button Grid.Column="2" Margin="8,0,0,0" Content="Показать _файл журнала" Command="{Binding ShowFileCommand}"
                    ToolTip="Открыть папку с файлом журнала в Проводнике" />
            <Button Grid.Column="3" Margin="8,0,0,0" Content="Закрыть" IsCancel="True" Command="ApplicationCommands.Close" />
        </Grid>
    </Grid>
</Window>
