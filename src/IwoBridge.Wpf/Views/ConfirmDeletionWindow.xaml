<Window x:Class="IwoBridge.Wpf.Views.ConfirmDeletionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтвердите удаление"
        Style="{StaticResource AppWindow}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=PhraseBox}">
    <!-- Последний рубеж перед удалением: что, где и как удаляется. «Удалить» доступна только после ввода адреса
         ящика (и отметки при окончательном удалении). Кнопка по умолчанию — «Отмена»: Enter и Esc ничего не удалят.
         Совпавший адрес подтверждается надписью с галочкой (не только цветом рамки — цвет различают не все).
         На маленьком экране текст прокручивается, кнопки остаются внизу окна. -->
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <TextBlock Style="{StaticResource TitleText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap">
                    <Run Text="Будет удалено:" />
                    <Run Text="{Binding Summary, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="Где" />
                <TextBlock TextWrapping="Wrap" Text="{Binding TargetLabel}" />

                <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="Как" />
                <TextBlock TextWrapping="Wrap" Text="{Binding ModeText}" />

                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="Перед удалением программа сохранит список удаляемого в файл — по нему можно проверить результат." />

                <Label Margin="0,16,0,0" Padding="0,0,0,4" Target="{Binding ElementName=PhraseBox}">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Чтобы подтвердить, введите" />
                        <Run FontWeight="SemiBold" Text="{Binding Phrase, Mode=OneWay}" />
                    </TextBlock>
                </Label>
                <TextBox x:Name="PhraseBox" Text="{Binding TypedPhrase, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="PhraseBox"
                         AutomationProperties.Name="Подтверждение: адрес ящика"
                         ToolTip="Регистр букв и пробелы по краям не важны">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PhraseMatches}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                            Visibility="{Binding PhraseMatches, Converter={StaticResource VisibleWhen}}">
                    <Path Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"
                          Stroke="{DynamicResource SuccessTextBrush}" StrokeThickness="2" Data="M1,6 L4.5,9.5 L11,2" />
                    <TextBlock Foreground="{DynamicResource SuccessTextBrush}" FontSize="13" Text="Адрес совпадает" />
                </StackPanel>

                <CheckBox Margin="0,12,0,0" IsChecked="{Binding UnderstoodIrreversible}"
                          Visibility="{Binding HardDelete, Converter={StaticResource VisibleWhen}}">
                    <TextBlock TextWrapping="Wrap" Text="Понимаю, что удалённое нельзя будет вернуть" />
                </CheckBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" IsCancel="True" IsDefault="True" ToolTip="Закрыть окно, ничего не удаляя (Enter или Esc)" />
            <Button Margin="8,0,0,0" Style="{StaticResource DangerButton}" Content="_Удалить"
                    IsEnabled="{Binding CanConfirm}" Click="OnConfirm"
                    AutomationProperties.AutomationId="ConfirmDeleteButton"
                    ToolTip="Доступно после ввода адреса ящика" />
        </StackPanel>
    </Grid>
</Window>
