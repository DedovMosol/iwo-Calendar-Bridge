<Project Sdk="Microsoft.NET.Sdk">

  <!-- Тесты адаптера Outlook без Outlook: перевод правил повторения. Чтение настоящего календаря проверяется вручную
       на машине с открытым Outlook. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyName>IwoBridge.Outlook.Tests</AssemblyName>
    <RootNamespace>IwoBridge.Outlook.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IwoBridge.Outlook\IwoBridge.Outlook.csproj" />
  </ItemGroup>

</Project>
